root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[*.md]
# Markdown 行尾双空格为换行语法，不裁剪
trim_trailing_whitespace = false

[*.{kt,kts}]
max_line_length = 120
# Composable 函数遵循 UI 命名习惯（名词命名），豁免函数命名规则检查
ktlint_function_naming_ignore_when_annotated_with = Composable
